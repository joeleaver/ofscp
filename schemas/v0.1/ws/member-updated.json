{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/ws/member-updated.json",
  "title": "OFSCP WS member.updated event (v0.1)",
  "description": "A group member's role or nickname changed (§5.7).",
  "allOf": [
    {
      "$ref": "./event-envelope.json"
    },
    {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "member.updated"
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "groupId",
            "member"
          ],
          "properties": {
            "groupId": {
              "$ref": "../defs/common.json#/$defs/LocalId"
            },
            "member": {
              "$ref": "../defs/groups.json#/$defs/Member"
            }
          }
        }
      }
    }
  ]
}
