    },
    {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "dm.conversation"
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "conversation"
          ],
          "properties": {
            "conversation": {
              "$ref": "../dm-conversation.json"
            }
          }
        }
      }
    }
  ]
}
