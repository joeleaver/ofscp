{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/ofscp/schemas/v0.1/user-keys-response.json",
    "title": "OFSCP User Public Keys Response",
    "type": "object",
    "properties": {
        "actor": {
            "$ref": "./defs/identity.json#/$defs/UserRef"
        },
        "keys": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "key_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "algorithm": {
                        "type": "string",
                        "description": "Key algorithm. v0.1 defines Ed25519 only (§4.3.3); a verifier ignores an entry with any other value (§4.3.2) rather than rejecting the document."
                    },
                    "public_key": {
                        "type": "string",
                        "description": "A published public key. Not constrained here: an entry whose public_key does not decode to an Ed25519 key of exactly 32 bytes, or whose algorithm the verifier does not support, is ignored on its own and leaves the rest of the document usable (§4.3.2, §4.3.3)."
                    },
                    "created_at": {
                        "$ref": "./defs/common.json#/$defs/Rfc3339DateTime"
                    }
                },
                "required": [
                    "key_id",
                    "algorithm",
                    "public_key",
                    "created_at"
                ]
            }
        },
        "cache_until": {
            "$ref": "./defs/common.json#/$defs/Rfc3339DateTime"
        }
    },
    "required": [
        "actor",
        "keys",
        "cache_until"
    ],
    "additionalProperties": true
}