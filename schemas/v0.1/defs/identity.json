{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/defs/identity.json",
  "title": "OFSCP v0.1 Identity definitions",
  "type": "object",
  "$defs": {
    "UserRef": {
      "description": "Actor (§2.2): `handle@domain`, where domain is the lowercased home-provider authority (with :port only if non-default). Every user-valued field uses this form.",
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,32}@[a-z0-9.-]+(:[0-9]{1,5})?$",
      "examples": [
        "jane@a.com"
      ]
    },
    "UserProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "handle",
        "domain",
        "updatedAt",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "./common.json#/$defs/HttpsUri"
        },
        "handle": {
          "$ref": "./common.json#/$defs/Handle"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "avatar": {
          "$ref": "./common.json#/$defs/HttpsUri"
        },
        "guest": {
          "type": "boolean",
          "description": "True for a provider-local temporary guest account (§4.8). Guest actors are not federated; remote providers MAY refuse them."
        },
        "expiresAt": {
          "$ref": "./common.json#/$defs/Rfc3339DateTime",
          "description": "For guest accounts: when the account expires. Absent for normal accounts."
        },
        "updatedAt": {
          "$ref": "./common.json#/$defs/Rfc3339DateTime"
        },
        "metadata": {
          "$ref": "./objects.json#/$defs/MetadataList"
        }
      }
    },
    "UserAccount": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "profile",
        "settings"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/UserProfile"
        },
        "settings": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "DeviceKey": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "./common.json#/$defs/Rfc3339DateTime"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "public_key",
        "created_at"
      ]
    }
  }
}