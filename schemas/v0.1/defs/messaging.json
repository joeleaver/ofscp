{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/defs/messaging.json",
  "title": "OFSCP v0.1 Messaging definitions",
  "type": "object",
  "$defs": {
    "Content": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "mime"],
      "properties": {
        "text": { "type": "string" },
        "mime": { "$ref": "./common.json#/$defs/MimeType" }
      }
    },
    "MessageReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "$ref": "./common.json#/$defs/LocalId" }
      }
    },
    "Permissions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "editUntil": { "$ref": "./common.json#/$defs/Rfc3339DateTime" }
      }
    },
    "MessageCreate": {
      "description": "Body that creates a channel message (§7.1): the data of the WS message.create command (which adds groupId and channelId) and the body of POST /api/groups/{groupId}/channels/{channelId}/messages. The provider sets id, author, createdAt and permissions.",
      "type": "object",
      "additionalProperties": true,
      "required": ["content"],
      "properties": {
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "description": "Client-chosen idempotency key: (author, channelId, clientMessageId) is idempotent (§7.1)."
        },
        "type": {
          "type": "string",
          "enum": ["message", "memo", "article"],
          "default": "message",
          "description": "Message type (§5.3); omitted means message. Gated by the channel's post:<type> permission (§5.2.1)."
        },
        "content": { "$ref": "#/$defs/Content" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "./objects.json#/$defs/Attachment" },
          "description": "Attachments as returned by POST /api/media (§5.8); omitted means []."
        },
        "reference": {
          "$ref": "#/$defs/MessageReference",
          "description": "A reply's parent (§7.2): type reply, and the id of a message in the same channel."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "$ref": "./objects.json#/$defs/MetadataList",
          "description": "Metadata objects (§5.4); omitted means []."
        }
      }
    },
    "BaseMessage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "author", "type", "content", "attachments", "createdAt", "metadata"],
      "properties": {
        "id": { "$ref": "./common.json#/$defs/LocalId" },
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "description": "Echo of the clientMessageId the create carried (§7.1, §7.4). It MUST be present on the author's copy of message.created and on the response to a create, first or duplicate; elsewhere a provider MAY include or omit it."
        },
        "author": { "$ref": "./identity.json#/$defs/UserRef" },
        "type": { "type": "string", "enum": ["message", "memo", "article"] },
        "content": { "$ref": "#/$defs/Content" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "./objects.json#/$defs/Attachment" }
        },
        "reference": { "$ref": "#/$defs/MessageReference" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "replyCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Advisory, non-authoritative count of messages whose reference.id is this message (§7.2). Clients MUST NOT rely on it for correctness."
        },
        "createdAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "editedAt": {
          "$ref": "./common.json#/$defs/Rfc3339DateTime",
          "description": "Set when the message has been edited (§7.1)."
        },
        "deletedAt": {
          "$ref": "./common.json#/$defs/Rfc3339DateTime",
          "description": "Set when the message is a tombstone: content is cleared and the id is retained (§7.1)."
        },
        "permissions": { "$ref": "#/$defs/Permissions" },
        "metadata": { "$ref": "./objects.json#/$defs/MetadataList" }
      }
    },
    "Reaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "author", "key", "reference", "createdAt", "metadata"],
      "properties": {
        "id": { "$ref": "./common.json#/$defs/LocalId" },
        "author": { "$ref": "./identity.json#/$defs/UserRef" },
        "key": { "type": "string", "minLength": 1 },
        "unicode": { "type": "string" },
        "image": { "$ref": "./common.json#/$defs/HttpsUri" },
        "reference": { "$ref": "#/$defs/MessageReference" },
        "createdAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "metadata": { "$ref": "./objects.json#/$defs/MetadataList" }
      }
    },
    "TimelineItem": {
      "description": "Union of message-like objects present in timelines.",
      "oneOf": [{ "$ref": "#/$defs/BaseMessage" }, { "$ref": "#/$defs/Reaction" }]
    },
    "PagedResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items", "page"],
      "properties": {
        "items": { "type": "array" },
        "page": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "nextCursor": { "$ref": "./common.json#/$defs/OpaqueCursor" },
            "prevCursor": { "$ref": "./common.json#/$defs/OpaqueCursor" }
          }
        }
      }
    }
  }
}
